# Copy this file to .env and fill in the three required values.
# Keep comments on their own lines: some tools do not understand "VALUE  # comment".

# ===== Required ================================================================

# Address of your Immich server, as seen from the container (with http:// or https://).
# Plain http on your local network is fine: the old device never talks to Immich directly.
IMMICH_URL=http://192.168.1.10:2283

# Immich > Account settings > API keys > New API key (see the README for permissions)
IMMICH_API_KEY=

# The album to show: open it in Immich, the id is the last part of the URL
# (https://immich.example/albums/<this-part>)
ALBUM_ID=

# ===== Display =================================================================

# en or fr: start screen and dates
LANGUAGE=en
# How long each photo stays on screen, in seconds
PHOTO_SECONDS=10
# Longer videos are cut, in seconds
MAX_VIDEO_SECONDS=60
# Play the videos' sound
VIDEO_SOUND=false
# Fill the screen (true) or show the whole photo with black bars (false)
CROP_PHOTOS=true
# Photos / videos whose orientation differs from the screen (e.g. landscape on a portrait
# frame): false = shown whole on a blurred background, true = cropped to fill the screen
# (a 16:9 landscape photo on a 3:4 portrait screen then loses more than half its width)
CROP_OTHER_ORIENTATION_PHOTOS=false
CROP_OTHER_ORIENTATION_VIDEOS=false
# Caption with the date the photo was taken, bottom left
SHOW_DATE=true
# Add the city (or state, or country) to the caption, when Immich knows it
SHOW_PLACE=true
# Small clock, bottom right
SHOW_CLOCK=false
# false = photos only, nothing is converted
INCLUDE_VIDEOS=true

# ===== Video conversion ========================================================
# Changing one of these converts every video again, automatically.

# Longest side in pixels; videos fit in a 1280x720 (or 720x1280) box by default
VIDEO_MAX_SIDE=1280
# Maximum bitrate
VIDEO_MAXRATE=3M
# How often the album is checked for new or removed videos, in minutes
RESCAN_MINUTES=60
# CPU cores used while converting
FFMPEG_THREADS=2

# ===== System ==================================================================

# Owner of the ./cache folder on the host (run `id` to see yours)
PUID=1000
PGID=1000
# Show the frame's own messages in `docker compose logs`
DEBUG_LOG=true
